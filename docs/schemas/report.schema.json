      },
      "title": "Edges",
      "type": "array"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Errors",
      "type": "array"
    },
    "parser_version": {
      "title": "Parser Version",
      "type": "string"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "title": "Scope",
      "type": "array"
    },
    "source_hash": {
      "title": "Source Hash",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNRESOLVED",
        "ERROR"
      ],
      "title": "Status",
      "type": "string"
