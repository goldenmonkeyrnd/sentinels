          "title": "Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "unresolved": {
          "items": {
            "type": "string"
