          "type": "string"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "witness": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Witness",
          "type": "array"
        }
      },
      "required": [
