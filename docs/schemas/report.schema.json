        "contracts": {
          "items": {
            "type": "string"
          },
          "title": "Contracts",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "function",
            "method",
            "class",
            "model",
            "export",
            "registration"
